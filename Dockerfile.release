# Used by GoReleaser: the binary is already built for the target platform.
FROM gcr.io/distroless/static-debian12:nonroot
# Proves ownership of the image to the official MCP registry (see server.json).
LABEL io.modelcontextprotocol.server.name="io.github.asinha07/spoor"
LABEL org.opencontainers.image.source="https://github.com/asinha07/spoor"
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/spoor /usr/local/bin/spoor
EXPOSE 8080
ENTRYPOINT ["spoor"]
# MCP over stdio by default, the convention for MCP images:
#   docker run -i --rm ghcr.io/asinha07/spoor
# For a shared HTTP server: docker run -p 8080:8080 ghcr.io/asinha07/spoor serve --http :8080
CMD ["serve"]
